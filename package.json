{
  "name": "fundedpro",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.3.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @fundedpro/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace @fundedpro/web",
    "check": "npm run lint && npm run typecheck && npm run test",
    "db:generate": "npm run db:generate --workspace @fundedpro/db",
    "db:migrate": "npm run db:migrate --workspace @fundedpro/db",
    "db:deploy": "npm run db:deploy --workspace @fundedpro/db",
    "db:seed": "npm run db:seed --workspace @fundedpro/db",
    "worker:dev": "npm run dev --workspace @fundedpro/worker"
  }
}
